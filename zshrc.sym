# Bare survival config. Fish is the primary shell (~/.dotfiles/config.fish).
# This exists only so zsh isn't broken if it's ever launched directly
# (e.g. macOS default shell before switching, or a one-off tool that shells out to zsh).

export EDITOR="nvim"

# Drop into fish for interactive use.
if [[ -o interactive ]] && command -v fish >/dev/null 2>&1; then
  exec fish
fi
